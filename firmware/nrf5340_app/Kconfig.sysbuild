# The --gatt scripts select SB_CONFIG_NETCORE_HCI_IPC=y. NCS netcore.cmake then
# builds Zephyr's samples/bluetooth/hci_ipc for the cpunet target and, on Bsim,
# composes it with nrf5340_app into the final zephyr.exe.
source "share/sysbuild/Kconfig"

config NATIVE_SIMULATOR_PRIMARY_MCU_INDEX
	int
	# Keep device arguments on the application core; hci_ipc is the child MCU.
	default 0 if $(BOARD_TARGET_STRING) = "NRF5340BSIM_NRF5340_CPUAPP"
