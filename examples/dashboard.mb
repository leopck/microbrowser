<microbrowser name="Home climate">
  <state>
    <field name="temperature" type="f32" value="22.4"/>
    <field name="target" type="f32" value="21.5"/>
    <field name="humidity" type="f32" value="46"/>
    <field name="co2" type="f32" value="642"/>
    <field name="battery" type="f32" value="3.9"/>
    <field name="power" type="f32" value="0.8"/>
    <field name="elapsed" type="f32" value="0"/>
    <field name="refresh_timer" type="f32" value="0"/>
    <field name="tick_timer" type="f32" value="0"/>
    <field name="mode" type="string" value="Auto"/>
    <field name="room" type="string" value="Living room"/>
    <field name="status" type="string" value="Local simulation ready"/>
    <field name="sensor_site" type="string" value="Hall sensor"/>
    <field name="sensor_online" type="bool" value="true"/>
    <field name="alerts" type="bool" value="true"/>
    <field name="diagnostic_json" type="string" value='{"sensor":{"battery":3.9,"connected":true,"site":"Hall sensor"}}'/>
  </state>
  <style>
    .screen { background: #F1F4F9; color: #172033; font-size: 14; font-weight: 400; padding: 12; gap: 12; width: 100%; height: 100%; }
    .card { background: #FFFFFF; color: #172033; border: #DDE3EE; radius: 12; padding: 16; gap: 12; }
    .row { gap: 12; align: center; }
    .tiles { align: stretch; }
    .grow { width: grow; }
    .compact { gap: 4; }
    .title { font-size: 20; font-weight: 600; color: #172033; }
    .section-title { font-size: 16; font-weight: 600; color: #172033; }
    .label { font-size: 12; font-weight: 400; color: #64748B; }
    .muted { font-size: 12; font-weight: 400; color: #64748B; }
    .body { font-size: 14; font-weight: 400; color: #475569; }
    .value { font-size: 14; font-weight: 400; color: #172033; }
    .value-strong { font-size: 14; font-weight: 600; color: #172033; }
    .reading { font-size: 36; font-weight: 600; color: #172033; }
    .metric { font-size: 28; font-weight: 600; color: #172033; }
    .small-metric { font-size: 20; font-weight: 600; color: #172033; }
    .badge { background: #E0E7FF; color: #3730A3; font-size: 12; font-weight: 600; radius: 8; padding: 4; }
    .button { background: #E9EDF5; color: #3730A3; border: #D8DFEC; font-size: 14; font-weight: 600; radius: 8; padding: 12; height: 44; }
    .primary { background: #4F46E5; color: #FFFFFF; border: #4F46E5; }
    .toggle { background: #E0E7FF; color: #3730A3; border: #C7D2FE; }
    .input { background: #FFFFFF; color: #172033; border: #CBD5E1; font-size: 16; font-weight: 400; radius: 8; padding: 12; width: grow; height: 44; }
    .slider { width: grow; height: 32; color: #4F46E5; }
    .progress { width: grow; height: 8; color: #4F46E5; radius: 4; }
    .success { color: #0F766E; }
    .chart { background: #F8FAFC; color: #4F46E5; border: #E2E8F0; radius: 8; height: 72; width: grow; }
    .status { font-size: 12; font-weight: 400; color: #64748B; width: grow; }
  </style>
  <asset name="climate_art" src="assets/climate_mark.png" resize="32x32"/>

  <page name="dashboard">
    <column id="dashboard_root" class="screen" scroll="true" on_load="start_app()">
      <row id="dashboard_header" class="row">
        <image id="dashboard_logo" src="climate_art" width="32" height="32" animate="pulse:900"/>
        <column class="grow compact">
          <text class="title" text="Home climate"/>
          <text class="muted" bind="{state.room}" format="%s"/>
        </column>
        <spacer/>
        <button class="button" text="Details" on_press="open_details()"/>
        <button class="button primary" text="Settings" on_press="open_settings()"/>
      </row>

      <column id="overview" class="card" animate="fade:240">
        <row class="row">
          <text class="section-title" text="Indoor climate"/>
          <spacer/>
          <text class="label" text="Mode"/>
          <text class="badge" value="{state.mode}" format="%s"/>
        </row>
        <row class="row">
          <text class="reading" value="{state.temperature}" format="%.1f °C"/>
          <spacer/>
          <column class="compact" align="end">
            <text class="label" text="Humidity"/>
            <text class="small-metric" value="{state.humidity}" format="%.0f%%"/>
          </column>
        </row>
        <row class="row">
          <text class="label" text="Target"/>
          <text class="small-metric" value="{state.target}" format="%.1f °C"/>
          <spacer/>
          <button class="button" text="−" on_press="decrease_target()"/>
          <button class="button primary" text="+" on_press="increase_target()"/>
          <button class="button" text="Auto / Heat" on_press="toggle_mode()"/>
        </row>
        <slider id="dashboard_target" class="slider" bind="{state.target}" min="16" max="28" step="0.5" on_change="overview_target_changed()"/>
      </column>

      <column class="card">
        <row class="row">
          <text class="section-title" text="Environment trend"/>
          <spacer/>
          <text class="muted" text="20-24 °C"/>
        </row>
        <chart id="trend" class="chart" min="20" max="24" samples="21.8,22.0,22.1,22.4"/>
      </column>

      <row id="environment_cards" class="row tiles">
        <column id="humidity_card" class="card grow">
          <text class="section-title" text="Humidity"/>
          <text class="metric" value="{state.humidity}" format="%.0f%%"/>
          <progress class="progress" value="{state.humidity}" min="0" max="100"/>
          <text class="muted" text="Comfort range 40-60%"/>
        </column>
        <column id="air_card" class="card grow">
          <text class="section-title" text="Air quality"/>
          <text class="metric" value="{state.co2}" format="%.0f ppm"/>
          <text class="label" text="CO2 concentration"/>
          <text class="muted" bind="{state.sensor_site}"/>
        </column>
      </row>

      <column class="card">
        <text class="section-title" text="Local sensor simulation"/>
        <text class="body" text="Local data only • no network required"/>
        <text class="body" bind="{state.status}"/>
        <row class="row">
          <button class="button primary" text="Refresh snapshot" on_press="schedule_refresh()"/>
          <button class="button" text="Cancel pending" on_press="cancel_refresh()"/>
          <button class="button" text="Toggle sensor" on_press="toggle_connection()"/>
        </row>
        <row class="row">
          <text class="label" text="Sensor connection"/>
          <spacer/>
          <text class="value-strong" bind="{state.sensor_online}"/>
        </row>
      </column>
    </column>
  </page>

  <page name="details">
    <column id="details_root" class="screen" scroll="true" on_load="start_details()">
      <row class="row">
        <button class="button" text="← Back" on_press="go_back()"/>
        <text class="title" text="Environment trends"/>
        <spacer/>
        <text class="muted" value="{state.elapsed}" format="%.0f s"/>
      </row>
      <column class="card" animate="slide:180">
        <row class="row">
          <text class="section-title" text="Temperature history"/>
          <spacer/>
          <text class="muted" text="20-24 °C"/>
        </row>
        <chart id="trend" class="chart" height="120" min="20" max="24" samples="21.2,21.4,21.3,21.6,21.9,22.0,22.2,22.4" animate="fade:200"/>
        <row class="row">
          <text class="label" text="Humidity"/>
          <text class="value-strong" value="{state.humidity}" format="%.0f%%"/>
          <spacer/>
          <text class="label" text="Battery"/>
          <text class="value-strong" value="{state.battery}" format="%.2f V"/>
        </row>
      </column>
      <column id="overview" class="card" animate="pulse">
        <text class="section-title" text="Setpoint and energy"/>
        <row class="row">
          <column class="compact">
            <text class="label" text="Target"/>
            <text class="small-metric" value="{state.target}" format="%.1f °C"/>
          </column>
          <spacer/>
          <column class="compact" align="end">
            <text class="label" text="Power estimate"/>
            <text class="small-metric" value="{state.power}" format="%.2f kW"/>
          </column>
        </row>
        <slider id="details_target" class="slider" value="{state.target}" min="16" max="28" step="0.5" on-change="overview_target_changed()"/>
        <row class="row">
          <button class="button" text="Target −" on_press="decrease_target()"/>
          <button class="button primary" text="Target +" on_press="increase_target()"/>
          <button class="button" text="Save setpoint" on_press="save_target()"/>
        </row>
      </column>
      <column class="card">
        <text class="section-title" text="Air quality"/>
        <row class="row">
          <text class="small-metric" value="{state.co2}" format="%.0f ppm"/>
          <spacer/>
          <text class="muted" bind="{state.sensor_site}"/>
        </row>
        <progress class="progress success" bind="{state.co2}" min="0" max="1600" height="10"/>
        <button class="button primary" text="Sample offline sensor" on_press="schedule_refresh()"/>
      </column>
    </column>
  </page>

  <page name="settings">
    <column id="settings_root" class="screen" scroll="true" on_load="start_settings()">
      <row class="row">
        <button class="button" text="← Back" on_press="go_back()"/>
        <text class="title" text="Climate settings"/>
      </row>
      <column class="card">
        <text class="section-title" text="Room"/>
        <text class="muted" text="Shown on the overview and saved on this device."/>
        <input id="room_input" class="input" bind="{state.room}" placeholder="Room name" max-length="32" on_change="room_changed()" on_submit="save_room()"/>
        <row class="row">
          <text class="label" text="Current room"/>
          <spacer/>
          <text class="value-strong" bind="{state.room}" format="%s"/>
        </row>
        <row class="row">
          <button class="button primary" text="Save room" on_press="save_room()"/>
          <button class="button" text="Use Hall preset" on_press="use_hall()"/>
        </row>
      </column>
      <column class="card">
        <text class="section-title" text="Temperature target"/>
        <row class="row">
          <text class="small-metric" value="{state.target}" format="%.1f °C"/>
          <spacer/>
          <text class="label" text="Mode"/>
          <text class="badge" value="{state.mode}" format="%s"/>
        </row>
        <slider id="settings_target" class="slider" bind="{state.target}" min="16" max="28" step="0.5" on_change="target_changed()"/>
        <row class="row">
          <button class="button" text="Target −" on_press="decrease_target()"/>
          <button class="button primary" text="Target +" on_press="increase_target()"/>
          <button class="button" text="Save setpoint" on_press="save_target()"/>
        </row>
      </column>
      <column class="card">
        <text class="section-title" text="Alerts and persistence"/>
        <row class="row">
          <text class="body" text="High-CO2 alerts"/>
          <spacer/>
          <text class="value-strong" bind="{state.alerts}"/>
        </row>
        <button class="button toggle" text="Toggle alerts" on_press="toggle_alerts()"/>
        <text class="muted" text="Target, room, mode, and alert choices"/>
        <text class="muted" text="are restored when the app launches."/>
        <button class="button primary" text="Save current configuration" on_press="save_all()"/>
        <button class="button" text="Run local selftest" on_press="selftest()"/>
      </column>
      <column class="card">
        <text class="section-title" text="Device session"/>
        <text class="status" bind="{state.status}"/>
        <button class="button" text="Stop timers" on_press="stop_timers()"/>
      </column>
    </column>
  </page>
  <script><![CDATA[
    fn sanitize_target(value) {
      let bounded = clamp(value, 16, 28);
      return round(bounded * 2) / 2;
    }

    fn room_length() {
      return len(state.room);
    }

    fn update_setpoint_status() {
      state.status = "Setpoint " + string(state.target) + " °C";
    }

    fn set_target(value) {
      state.target = sanitize_target(value);
      update_setpoint_status();
    }

    fn pulse_overview() {
      animate("overview", "scale", 1.02, 120);
    }

    fn target_changed() {
      set_target(state.target);
    }

    fn overview_target_changed() {
      set_target(state.target);
      pulse_overview();
    }

    fn decrease_target() {
      set_target(state.target - 0.5);
      pulse_overview();
    }

    fn increase_target() {
      set_target(state.target + 0.5);
      pulse_overview();
    }

    fn save_target() {
      save_number("thermostat.target", state.target);
      state.status = "Setpoint saved";
      log("thermostat setpoint saved");
    }

    fn save_room() {
      save_string("thermostat.room", state.room);
      state.status = "Room name saved (" + string(room_length()) + " characters)";
      log("room setting saved");
    }

    fn use_hall() {
      state.room = "Hall";
      save_room();
    }

    fn room_changed() {
      state.status = "Room name edited";
    }

    fn toggle_alerts() {
      state.alerts = !state.alerts;
      save_bool("thermostat.alerts", state.alerts);
      state.status = "Alert preference saved";
    }

    fn toggle_connection() {
      state.sensor_online = !state.sensor_online;
      save_bool("sensor.online", state.sensor_online);
      state.status = "Offline sensor state changed";
    }

    fn toggle_mode() {
      if (state.mode == "Auto") {
        state.mode = "Heat";
      } else {
        state.mode = "Auto";
      }
      save_string("thermostat.mode", state.mode);
      state.status = "Mode set to " + state.mode;
      if (state.power < 0.25) {
        animate("overview", "opacity", 0.85, 100);
      }
    }

    fn refresh_sensors() {
      state.refresh_timer = 0;
      state.humidity = clamp(state.humidity + sin(state.elapsed / 5), 35, 65);
      state.co2 = max(420, min(1200, state.co2 + cos(state.elapsed / 7) * 12));
      state.battery = json_number(state.diagnostic_json, "sensor.battery");
      state.battery = floor(state.battery * 100) / 100;
      state.sensor_site = json_string(state.diagnostic_json, "sensor.site");
      state.sensor_online = json_bool(state.diagnostic_json, "sensor.connected");
      state.power = round(abs(state.target - state.temperature) * 100) / 250;
      chart_push("trend", state.temperature);
      animate("trend", "offset_y", 0, 120);
      state.status = "Offline snapshot updated";
      log("offline sensor snapshot updated");
    }

    fn tick() {
      state.elapsed = state.elapsed + 1;
      if (state.mode == "Heat") {
        state.temperature = state.temperature + 0.01;
      } else {
        state.temperature = state.temperature + (state.target - state.temperature) * 0.01;
      }
      if (state.elapsed == 5 || state.elapsed == 15 || state.elapsed == 30 || state.elapsed == 60) {
        chart_push("trend", state.temperature);
      }
    }

    fn schedule_refresh() {
      if (state.refresh_timer > 0) {
        cancel(state.refresh_timer);
      }
      state.refresh_timer = after(150, "refresh_sensors");
      state.status = "Offline sample scheduled";
    }

    fn cancel_refresh() {
      if (state.refresh_timer > 0) {
        cancel(state.refresh_timer);
      }
      state.refresh_timer = 0;
      state.status = "Pending sample cancelled";
    }

    fn stop_timers() {
      if (state.refresh_timer > 0) {
        cancel(state.refresh_timer);
      }
      if (state.tick_timer > 0) {
        cancel(state.tick_timer);
      }
      state.refresh_timer = 0;
      state.tick_timer = 0;
      state.status = "Timers stopped";
    }

    fn selftest() {
      let high = sanitize_target(100);
      let low = sanitize_target(-100);
      let midpoint = sanitize_target(22.25);
      let passed = high == 28 && low == 16 && midpoint == 22.5;
      if (passed) {
        state.status = "Local selftest passed";
        log("dashboard local selftest passed");
      } else {
        state.status = "Local selftest failed";
        log("dashboard local selftest failed");
      }
    }

    fn save_all() {
      save_target();
      save_room();
      save_bool("thermostat.alerts", state.alerts);
      save_string("thermostat.mode", state.mode);
      state.status = "Configuration saved on this device";
    }

    fn start_app() {
      let restored_target = load_number("thermostat.target", state.target);
      let restored_room = load_string("thermostat.room", state.room);
      let restored_mode = load_string("thermostat.mode", state.mode);
      let restored_alerts = load_bool("thermostat.alerts", state.alerts);
      let restored_online = load_bool("sensor.online", state.sensor_online);
      state.target = sanitize_target(restored_target);
      state.room = restored_room;
      state.mode = restored_mode;
      state.alerts = restored_alerts;
      state.sensor_online = restored_online;
      if (state.tick_timer > 0) {
        cancel(state.tick_timer);
      }
      state.tick_timer = every(1000, "tick");
      state.status = "Local settings restored";
      log("climate dashboard started without network access");
    }

    fn start_details() {
      log("environment details opened");
    }

    fn start_settings() {
      state.status = "Settings remain on this device";
    }

    fn open_details() {
      go("details");
    }

    fn open_settings() {
      stop_timers();
      go("settings");
    }

    fn go_back() {
      back();
    }
  ]]></script>
</microbrowser>
